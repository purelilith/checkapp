<?xml version="1.0" encoding="utf-8"?>

<FrameLayout  xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultTextContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:padding="0dp">
    <ScrollView
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:id="@+id/main">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFF4D4"
            android:padding="25dp"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/backButtonOCR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFF4D4"
                android:src="@drawable/ic_back_round">
            </ImageButton>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/btns_common"
                android:layout_gravity="center">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="15dp"
                    android:textColor="#FFF4D4"
                    android:fontFamily="@font/findsans_pro"
                    android:gravity="center"
                    android:text="Сфотографируйте \nсостав"
                    android:textSize="26sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <ImageView
                android:id="@+id/cameraImage"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:background="@drawable/ic_camera"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/block_green"
            android:orientation="vertical">
            <Button
                android:textColor="#105C08"
                android:id="@+id/captureImgBtn"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/btns_mini"
                android:fontFamily="@font/geologica_auto_medium"
                android:text="Сделать фото"
                android:textSize="25sp"
                app:backgroundTint="@null" />

            <Button
                android:textColor="#105C08"
                android:id="@+id/engCaptureImgBtn"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:text="Галерея"
                app:backgroundTint="@null"
                android:background="@drawable/btns_mini"
                android:layout_gravity="center"
                android:textSize="25sp"
                android:fontFamily="@font/geologica_auto_medium"
                android:layout_marginTop="15dp"/>
        </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geologica_auto_medium"
                android:text="Ингредиенты"
                android:layout_gravity="center"
                android:textSize="25sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                >

                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:fontFamily="@font/geologica_auto_medium"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/text_field"
                    android:padding="30dp"
                    android:scrollbars="vertical"
                    android:text=""
                    android:textSize="27sp"
                    android:textColor="@color/black" />
            </ScrollView>

            <Button
                android:id="@+id/takeCharBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#105C08"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:background="@drawable/btns_mini"
                android:fontFamily="@font/geologica_auto_medium"
                android:text="Расшифровать состав"
                android:textSize="25sp"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>