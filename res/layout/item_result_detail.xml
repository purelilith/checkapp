<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Верхняя строка: Код и Название -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/resCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geologica_auto_medium"
                android:text="E102"
                android:textColor="#D42C2C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:fontFamily="@font/geologica_auto_medium"
                android:text="Тартразин"
                android:textColor="#333333"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Статус: Разрешен/Запрещен -->
        <TextView
            android:id="@+id/resLegality"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/geologica_auto_medium"
            android:text="Статус: Запрещен"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Разделительная линия -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.1"
            android:background="#000000" />

        <!-- Описание -->
        <TextView
            android:id="@+id/resDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geologica_auto_medium"
            android:lineSpacingExtra="4dp"
            android:text="Подробное описание того, как эта добавка влияет на организм человека..."
            android:textColor="#666666"
            android:textSize="15sp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>